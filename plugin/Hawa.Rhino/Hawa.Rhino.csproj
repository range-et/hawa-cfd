</ItemGroup><PropertyGroup><TargetExt>.rhp</TargetExt><SdkReferences Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(RhinoSystem)/ref/net48</SdkReferences><SdkReferences Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(RhinoSystem)</SdkReferences></PropertyGroup><ItemGroup><ProjectReference Include="../Hawa.Shared/Hawa.Shared.csproj" /></ItemGroup><ItemGroup><EmbeddedResource Include="Assets/*.png" /><EmbeddedResource Include="Assets/*.ico" /></ItemGroup></Project>