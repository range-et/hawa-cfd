<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><TargetFramework>net7.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><Version>0.5.0</Version><PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
<RhinoSystem Condition="'$(RhinoSystem)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources</RhinoSystem>
